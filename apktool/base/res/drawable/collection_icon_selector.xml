<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/collection_icon_state_expanded" android:drawable="@drawable/ic_arrow_down" android:state_activated="true" />
    <item android:id="@id/collection_icon_state_collapsed" android:drawable="@drawable/chevron_right" />
    <transition android:drawable="@drawable/collection_expand_avd" android:toId="@id/collection_icon_state_expanded" android:fromId="@id/collection_icon_state_collapsed" />
    <transition android:drawable="@drawable/collection_collapse_avd" android:toId="@id/collection_icon_state_collapsed" android:fromId="@id/collection_icon_state_expanded" />
</animated-selector>
