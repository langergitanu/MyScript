<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="@android:integer/config_mediumAnimTime" android:exitFadeDuration="@android:integer/config_mediumAnimTime"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/tutorial_indicator_selected_color" />
            <size android:height="@dimen/pager_indicator_size" android:width="@dimen/pager_indicator_size" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tutorial_indicator_color" />
            <size android:height="@dimen/pager_indicator_size" android:width="@dimen/pager_indicator_size" />
        </shape>
    </item>
</selector>
