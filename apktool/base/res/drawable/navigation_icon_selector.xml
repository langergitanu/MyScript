<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/navigation_icon_state_nested" android:drawable="@drawable/ic_arrow_back" android:state_activated="true" />
    <item android:id="@id/navigation_icon_state_main" android:drawable="@drawable/ic_close" />
    <transition android:drawable="@drawable/nav_close_to_back_avd" android:toId="@id/navigation_icon_state_nested" android:fromId="@id/navigation_icon_state_main" />
    <transition android:drawable="@drawable/nav_back_to_close_avd" android:toId="@id/navigation_icon_state_main" android:fromId="@id/navigation_icon_state_nested" />
</animated-selector>
